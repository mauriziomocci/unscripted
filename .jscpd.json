{
  "pattern": "**/*.{ts,tsx,js,mjs,cjs}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/legacy/**",
    "**/drizzle/**",
    "**/fixtures/**",
    "specs/**"
  ],
  "minLines": 11,
  "minTokens": 70,
  "threshold": 0,
  "reporters": ["console"],
  "gitignore": true
}
