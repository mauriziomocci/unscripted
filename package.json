{
  "name": "unscripted",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-taste-exemptions.ts && pnpm lint:dup",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}\"",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "golden:record": "echo 'golden:record: not yet wired' && exit 1",
    "golden:check": "echo 'golden:check: not yet wired' && exit 1",
    "lint:dup": "jscpd .",
    "content:generate": "node scripts/generate-prompt-modules.ts && node scripts/generate-pack-content.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "jscpd": "catalog:"
  }
}
