{
  "name": "unscripted",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "echo 'lint: not yet wired' && exit 1",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,html}\"",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "golden:record": "echo 'golden:record: not yet wired' && exit 1",
    "golden:check": "echo 'golden:check: not yet wired' && exit 1"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:"
  }
}
